# ---- Service ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://rampart:rampart@localhost:5432/rampart?schema=public
# 32 random bytes, base64. `npm run setup` generates one.
ENCRYPTION_KEY=

# ---- Stellar -----------------------------------------------------------------
STELLAR_NETWORK=TESTNET
# HORIZON_URL=https://horizon-testnet.stellar.org
# USDC_ISSUER=  # defaults to Circle's issuer for the network
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ---- On-chain receipts (optional) --------------------------------------------
# Record every verified live delivery in the ramp-receipts contract
# (contracts/README.md). Set both or neither. The attester account must be
# funded (it pays the fees) and added with `add_attester` by the admin.
# RECEIPTS_CONTRACT_ID=C...
# RECEIPTS_ATTESTER_SECRET=S...

# ---- Stripe Crypto Onramp (on-ramp) ------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- MoonPay (on-ramp + off-ramp) --------------------------------------------
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_KEY=
MOONPAY_BUY_URL=https://buy-sandbox.moonpay.com
MOONPAY_SELL_URL=https://sell-sandbox.moonpay.com
# Confirm these against your MoonPay account's currency list.
MOONPAY_CURRENCY_USDC=usdc_xlm
MOONPAY_CURRENCY_XLM=xlm

# ---- SEP-24 anchors (on-ramp + off-ramp) -------------------------------------
# Comma-separated allowlist of anchor home domains.
ANCHOR_DOMAINS=testanchor.stellar.org

# ---- API limits ---------------------------------------------------------------
# Requests per minute per API key / client secret / IP (0 = off).
# RATE_LIMIT_PER_MINUTE=300
# Behind a reverse proxy (so client IPs come from X-Forwarded-For):
# TRUST_PROXY=true
# docker-compose only: the bundled Postgres password.
# POSTGRES_PASSWORD=

# ---- Test mode and worker ----------------------------------------------------
# rk_test_ keys run on the simulated SANDBOX provider. Set to false to disable.
# SANDBOX_ENABLED=true
# SANDBOX_STEP_SECONDS=3
# Run the reconciler and webhook delivery inside the API process. Set to false
# when running `npm run worker` as a separate process (docker-compose does).
# WORKER_IN_PROCESS=true
