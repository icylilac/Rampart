# ---- Service ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://ricerca:ricerca@localhost:5432/ricerca_ramp?schema=public
# 32 random bytes, base64. `npm run setup` generates one.
ENCRYPTION_KEY=

# ---- Stellar -----------------------------------------------------------------
STELLAR_NETWORK=TESTNET
# HORIZON_URL=https://horizon-testnet.stellar.org
# USDC_ISSUER=  # defaults to Circle's issuer for the network

# ---- Stripe Crypto Onramp (on-ramp) ------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- MoonPay (on-ramp + off-ramp) --------------------------------------------
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_KEY=
MOONPAY_BUY_URL=https://buy-sandbox.moonpay.com
MOONPAY_SELL_URL=https://sell-sandbox.moonpay.com
# Confirm these against your MoonPay account's currency list.
MOONPAY_CURRENCY_USDC=usdc_xlm
MOONPAY_CURRENCY_XLM=xlm

# ---- SEP-24 anchors (on-ramp + off-ramp) -------------------------------------
# Comma-separated allowlist of anchor home domains.
ANCHOR_DOMAINS=testanchor.stellar.org
