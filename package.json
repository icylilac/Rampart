{
  "name": "rampart",
  "version": "0.1.0",
  "private": true,
  "description": "Non-custodial Stellar on/off-ramp infrastructure: one API over Stripe Crypto Onramp, SEP-24 anchors and MoonPay.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "preflight": "tsx scripts/preflight.ts",
    "anchor:check": "tsx scripts/check-anchor.ts",
    "receipt:check": "tsx scripts/check-receipt.ts",
    "postinstall": "prisma generate",
    "vercel-build": "sh scripts/vercel-build.sh",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "test": "vitest run",
    "project:create": "tsx src/cli/project-create.ts",
    "sdk:build": "npm run build -w @rampart/sdk",
    "sdk:test": "npm test -w @rampart/sdk"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^6.19.3",
    "@stellar/stellar-sdk": "^17.2.0",
    "fastify": "^5.12.5",
    "prisma": "^6.19.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
